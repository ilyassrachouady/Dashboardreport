# Explicit opt-in. Live mode never substitutes demo records.
DEMO_MODE=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=revenue_intelligence
# Protects the internal dashboard in production (HTTP Basic, username team).
REPORTING_PASSWORD=
# Separate server-to-server ingestion credential, minimum 32 characters.
INGEST_SECRET=
GHL_API_KEY=
GHL_LOCATION_ID=WgeDf11I8yBah6LRzZL1
# Maps canonical reporting field keys to actual GHL custom field IDs.
GHL_FIELD_MAP_JSON={}

# Server-only provider credentials.
WEBINARJAM_API_KEY=
TRAKYO_API_KEY=
# WebinarJam account/webinar identifiers (optional until needed by adapter).
WEBINARJAM_MEMBER_ID=
WEBINARJAM_WEBINAR_ID=
WEBINARJAM_WEBINAR_HASH=

# Map a specific WebinarJam occurrence external ID to its exact GHL cohort tag.
GHL_WEBINAR_TAG_MAP_JSON={}

# Reporting calendars, comma-separated; only these calendars are imported.
GHL_REPORTING_CALENDAR_IDS=W8BVoDU02Ez8uAbOnGHR

# Server-side live payment history. No new key is required if this key can read payments.
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_SANDBOX=false
